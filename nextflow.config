// nextflow.config

// Define profiles for different execution environments
profiles {
    // SLURM executor configuration
    slurm {
        process {
            executor = 'slurm'
            
            // Default resources for all processes
            queue = 'bcc'  // Update with your queue name
            cpus = 2
            memory = '8 GB'
            time = '4h'
            
            // Process-specific configurations for nf-core/rnaseq
            withName: 'NFCORE_RNASEQ:RNASEQ:.*:STAR_ALIGN' {
                cpus = 8
                memory = '64 GB'
                time = '8h'
            }
            
            withName: 'NFCORE_RNASEQ:RNASEQ:.*:SALMON_QUANT' {
                cpus = 4
                memory = '16 GB'
                time = '4h'
            }
            
            withName: 'NFCORE_RNASEQ:RNASEQ:.*:FASTQC' {
                cpus = 2
                memory = '4 GB'
                time = '2h'
            }
            
            withName: 'NFCORE_RNASEQ:RNASEQ:.*:MULTIQC' {
                cpus = 1
                memory = '8 GB'
                time = '2h'
            }
        }
        
        // Executor-specific settings
        executor {
            queueSize = 10  // Maximum number of jobs to submit at once
            submitRateLimit = '10/1min'  // Submit rate limit
            pollInterval = '30s'  // How often to check job status
        }
    }
    
    // Singularity container configuration
    singularity {
        singularity {
            enabled = true
            autoMounts = true
            // cacheDir = '/home/charliew/.singularity/cache'  // not being set here because NXF_SINGULARITY_CACHEDIR is set in .bashrc
        }
    }
}

// Global parameters (optional - you can still use command line params)
params {
    // You can set default values here, but command line will override
    max_cpus = 16
    max_memory = '128 GB'
    max_time = '24h'
}

// Resource limits to prevent jobs from requesting too much
process {
    // Prevent any single job from using more than these limits
    resourceLimits = [
        cpus: params.max_cpus,
        memory: params.max_memory,
        time: params.max_time
    ]
}

// Enable execution reports
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}